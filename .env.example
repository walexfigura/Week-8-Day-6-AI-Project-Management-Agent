# Copy this file to `.env` and fill in values. `.env` is git-ignored - never commit it.
# Everything except model-backed investigation/interpretation works without these.

# --- Required only for model-backed commands (investigate, demo without --offline, eval --llm)
OPENAI_API_KEY=

# Any OpenAI model that supports function calling in the Responses API.
OPENAI_MODEL=gpt-5.4-mini
# Reasoning effort for reasoning models: none, low, medium, high.
# Leave empty if your model does not support the reasoning parameter.
OPENAI_REASONING_EFFORT=low

# --- Agent limits -------------------------------------------------------------
PM_MAX_ITERATIONS=12
PM_MAX_TOOL_CALLS=30
PM_MAX_TOOL_OUTPUT_CHARS=12000
PM_REQUEST_TIMEOUT_SECONDS=120

# --- Local state --------------------------------------------------------------
# Folder holding the SQLite database (mock Monday.com/Slack/Gmail + agent state) and logs.
PM_STATE_DIR=state
# Name recorded as the approver when you approve something (defaults to your OS user name).
PM_APPROVER=

# Default scenario loaded by `init`. The simulated clock comes from the scenario,
# never from your computer's date.
PM_SCENARIO=launch-delay
